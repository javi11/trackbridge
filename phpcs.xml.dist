<?xml version="1.0"?>
<ruleset name="TrackBridge">
	<description>Coding standards for TrackBridge for WooCommerce.</description>

	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.9"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="trackbridge"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="trackbridge"/>
				<element value="Trackbridge"/>
				<element value="TRACKBRIDGE"/>
			</property>
		</properties>
	</rule>

	<!-- Tests follow PHPUnit conventions rather than WordPress file/class naming. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<!-- Test docblocks carry PHPUnit annotations rather than prose descriptions. -->
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<!-- Test bootstraps write diagnostics to a terminal, not to a browser. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
</ruleset>
